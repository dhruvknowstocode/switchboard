# SWITCHBOARD Backend — Environment Variables
# Copy to backend/.env for local development.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://switchboard:switchboard@localhost:5432/switchboard?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT — never commit real secrets
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=8h

# CORS — comma-separated origins (control plane + demo apps)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
