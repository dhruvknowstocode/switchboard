# =============================================================================
# SWITCHBOARD — Root environment template
# Copy to .env and adjust for local development.
# Backend and frontend also have their own .env.example files.
# =============================================================================

# PostgreSQL (matches docker-compose.yml)
POSTGRES_USER=switchboard
POSTGRES_PASSWORD=switchboard
POSTGRES_DB=switchboard
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=4000
DATABASE_URL=postgresql://neondb_owner:npg_K4Iy7rnBqLwD@ep-flat-surf-axo721ya-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
